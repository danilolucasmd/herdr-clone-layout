#!/usr/bin/env sh
# herdr-clone-layout — give every new workspace/worktree the same *geometry* as
# the workspace you were just in: the same tabs (labels + order) and the same
# pane split arrangement (directions + ratios). Panes open as bare shells — no
# commands are re-run (geometry only).
#
# Modes:
#   event   Driven by herdr via HERDR_PLUGIN_EVENT_JSON. On workspace.focused it
#           records the focus; on workspace.created / worktree.created it clones
#           the previously-focused workspace into the new (fresh) one.
#   apply   Manual: duplicate the current workspace into a brand-new workspace.
#
# Deps: herdr CLI + jq. POSIX sh (no arrays; pane handles are eval'd vars).

set -u

HERDR="${HERDR_BIN_PATH:-herdr}"
# herdr exports HERDR_PLUGIN_ROOT and runs the hook with it as the working
# directory; fall back to this script's own location so a direct invocation
# (tests, manual runs) also finds plan.jq.
ROOT=${HERDR_PLUGIN_ROOT:-$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)}
PLAN_JQ="$ROOT/lib/plan.jq"
STATE="${HERDR_PLUGIN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr-clone-layout}"
mkdir -p "$STATE/claimed" 2>/dev/null || true
FOCUS_FILE="$STATE/focus-history"
KNOWN_FILE="$STATE/populated-workspaces"
# Set while `apply` creates its own workspace, so the event hooks that fire for
# it don't pop a dialog asking about a layout the user already asked for.
NOPROMPT_FILE="$STATE/suppress-prompt"
# The dialog's checkboxes, one file each: should a new workspace inherit a layout
# at all, and should its panes reopen what they were running? Written when the
# dialog is confirmed, read the next time one opens.
CLONE_BOX='clone-enabled'
APPS_BOX='reopen-apps'
LOG_FILE="$STATE/clone-layout.log"

# On by default — a headless hook leaves no other trace of what it did.
# Set HERDR_CLONE_LAYOUT_LOG=0 to silence it.
log() {
  [ "${HERDR_CLONE_LAYOUT_LOG:-1}" = "0" ] && return 0
  printf '%s %s\n' "$(date +%H:%M:%S)" "$*" >>"$LOG_FILE" 2>/dev/null || true
}

# Keep the log bounded; trimmed once per invocation, not once per line.
trim_log() {
  [ -f "$LOG_FILE" ] || return 0
  lines=$(wc -l <"$LOG_FILE" 2>/dev/null) || return 0
  [ "${lines:-0}" -gt 500 ] 2>/dev/null || return 0
  # $$ keeps concurrent hooks off each other's temp file. A new worktree fires
  # three events within milliseconds, and on a shared temp path their writes
  # interleave — the winner of the race then moves a truncated log into place.
  log_tmp="$LOG_FILE.$$"
  if tail -n 500 "$LOG_FILE" >"$log_tmp" 2>/dev/null; then
    mv "$log_tmp" "$LOG_FILE" 2>/dev/null || rm -f "$log_tmp" 2>/dev/null
  fi
}

# Full snapshot's .snapshot object (tabs/panes/workspaces/layouts/focus).
snapshot() { "$HERDR" api snapshot 2>/dev/null | jq -c '.result.snapshot'; }

# Long enough for herdr to finish reacting to something, short enough not to be
# felt. A fraction of a second is all it takes; POSIX only promises whole seconds
# from sleep, so fall back to one if this sleep won't take a fraction.
settle() { sleep 0.2 2>/dev/null || sleep 1; }

# ----------------------------------------------------------------------------
# the remembered answers — the dialog's checkboxes
#
# Each box is one file holding "1" or "0", kept here so the popup opens with the
# boxes ticked the way you left them. Anything but a stored "0" counts as on, so
# a fresh install starts with both ticked, and a state dir that cannot be written
# behaves the same rather than quietly turning features off.
#
# clone-enabled gates the paths that clone WITHOUT asking (a worktree, a
# workspace built in the background): there is no popup on those, so the
# remembered answer is the only answer available. The popup itself is shown
# regardless, since unticking the box is what it is for.
#
# reopen-apps decides what a clone copies: geometry alone, or geometry plus
# whatever each pane was running.
# ----------------------------------------------------------------------------
remembered() { # box -> 0 if it is ticked
  [ "$(cat "$STATE/$1" 2>/dev/null)" != "0" ]
}

remember() { # box 1|0
  # Write-then-rename so a reader never sees a half-written file, and never fail
  # the caller over it — a lost preference is not worth abandoning the clone.
  box_tmp="$STATE/$1.$$"
  if printf '%s\n' "$2" >"$box_tmp" 2>/dev/null; then
    mv "$box_tmp" "$STATE/$1" 2>/dev/null || rm -f "$box_tmp" 2>/dev/null
  fi
  return 0
}

clone_enabled() { remembered "$CLONE_BOX"; }   # clone a layout at all?
apps_enabled()  { remembered "$APPS_BOX";  }   # re-run what the panes had open?

# ----------------------------------------------------------------------------
# focus history: one workspace id per line, most-recent last, capped at 20.
# ----------------------------------------------------------------------------
record_focus() {
  ws=$1
  [ -n "$ws" ] || return 0
  last=$(tail -n 1 "$FOCUS_FILE" 2>/dev/null)
  [ "$last" = "$ws" ] && return 0
  printf '%s\n' "$ws" >>"$FOCUS_FILE"
  tail -n 20 "$FOCUS_FILE" >"$FOCUS_FILE.tmp" 2>/dev/null && mv "$FOCUS_FILE.tmp" "$FOCUS_FILE"
}

# Is $ws worth cloning from? (exists and has >1 tab or >1 pane)
ws_is_populated() { # snap ws
  printf '%s' "$1" | jq -e --arg w "$2" \
    'any(.workspaces[]; .workspace_id == $w and (.tab_count > 1 or .pane_count > 1))' \
    >/dev/null 2>&1
}

# Is $ws a fresh, untouched workspace? (exactly 1 tab and 1 pane)
ws_is_fresh() { # snap ws
  printf '%s' "$1" | jq -e --arg w "$2" \
    'any(.workspaces[]; .workspace_id == $w and .tab_count == 1 and .pane_count == 1)' \
    >/dev/null 2>&1
}

# ----------------------------------------------------------------------------
# populated-workspace history
#
# "1 tab and 1 pane" says a workspace is EMPTY, not that it is NEW. A workspace
# the user has closed all their tabs in looks exactly like one herdr just made,
# so freshness alone would re-clone it and undo the teardown they were doing.
#
# So remember every workspace seen holding more than one tab or pane: it has had
# a layout at some point, and is never a clone target again. A brand-new
# workspace has never been populated, so it is still eligible.
#
# Ids that no longer exist are dropped on every pass, so when herdr recycles a
# workspace id the reused id correctly counts as new again.
# ----------------------------------------------------------------------------
ws_known() { # ws  -> 0 if $ws has held a layout before
  [ -f "$KNOWN_FILE" ] && grep -qxF "$1" "$KNOWN_FILE" 2>/dev/null
}

remember_populated() { # snap
  # Command substitution (not a pipeline) so a jq failure on a malformed or
  # empty snapshot is actually visible here, instead of being masked by the exit
  # status of a trailing `sort`.
  cur=$(printf '%s' "$1" | jq -r '.workspaces[].workspace_id' 2>/dev/null) || return 0
  # A session always has at least one workspace, so an empty list means the
  # snapshot failed (server restarting, socket gone) rather than that every
  # workspace was closed. Bail instead of forgetting the whole history.
  [ -n "$cur" ] || return 0
  pop=$(printf '%s' "$1" | jq -r \
    '.workspaces[] | select(.tab_count > 1 or .pane_count > 1) | .workspace_id' 2>/dev/null) || return 0

  # $$ keeps concurrent hooks off each other's temp files; the mv is atomic, so
  # the loser of a race just writes an equivalent list a moment later.
  tmp="$KNOWN_FILE.$$"
  printf '%s\n' "$cur" | sort -u >"$tmp.cur"
  { [ -n "$pop" ] && printf '%s\n' "$pop"
    cat "$KNOWN_FILE" 2>/dev/null
  } | sort -u >"$tmp.all"
  # Intersect "has been populated" with "still exists".
  comm -12 "$tmp.all" "$tmp.cur" >"$tmp" 2>/dev/null && mv "$tmp" "$KNOWN_FILE"
  rm -f "$tmp" "$tmp.cur" "$tmp.all"
}

ws_is_focused() { # snap ws
  [ "$(printf '%s' "$1" | jq -r '.focused_workspace_id // empty' 2>/dev/null)" = "$2" ]
}

# Is $ws a linked git worktree? Its directory was settled when it was created, so
# the popup's directory row opens on the checkout — and cancelling never throws
# one away, since a worktree is a checkout on disk and not just a workspace.
ws_is_worktree() { # snap ws
  printf '%s' "$1" | jq -e --arg w "$2" \
    'any(.workspaces[]; .workspace_id == $w and .worktree.is_linked_worktree == true)' \
    >/dev/null 2>&1
}

# The directory a workspace is "in": its checkout when herdr tracks one (not
# every workspace is a repo), otherwise wherever its panes are actually sitting.
ws_dir() { # snap ws
  printf '%s' "$1" | jq -r --arg w "$2" '
    first(.workspaces[] | select(.workspace_id == $w) | .worktree.checkout_path // empty)
    // first(.panes[] | select(.workspace_id == $w) | .cwd // empty)
    // empty' 2>/dev/null
}

# Choose the workspace to clone from: the currently-focused one if it isn't the
# new workspace, otherwise the most recent distinct entry in the focus history.
# Only a populated workspace qualifies. Echoes the id (may be empty).
pick_source() { # snap new
  snap=$1; new=$2
  focused=$(printf '%s' "$snap" | jq -r '.focused_workspace_id // empty')
  { printf '%s\n' "$focused"; awk '{a[NR]=$0} END{for(i=NR;i>=1;i--)print a[i]}' "$FOCUS_FILE" 2>/dev/null; } \
  | while IFS= read -r c; do
      [ -n "$c" ] || continue
      [ "$c" = "$new" ] && continue
      if ws_is_populated "$snap" "$c"; then printf '%s\n' "$c"; break; fi
    done | head -n 1
}

# ----------------------------------------------------------------------------
# building blocks — extract new ids via snapshot diff (output-shape agnostic)
# ----------------------------------------------------------------------------
ws_tab_ids()  { snapshot | jq -c --arg w "$1" '[.tabs[]  | select(.workspace_id == $w) | .tab_id]'; }
ws_pane_ids() { snapshot | jq -c --arg w "$1" '[.panes[] | select(.workspace_id == $w) | .pane_id]'; }

create_tab() { # target label cwd  -> new tab id
  target=$1; label=$2; cwd=${3:-}
  before=$(ws_tab_ids "$target")
  # No arrays in POSIX sh, so build the argv in the positional params. The
  # originals are already saved above.
  set -- tab create --workspace "$target"
  [ -n "$label" ] && set -- "$@" --label "$label"
  [ -n "$cwd" ] && set -- "$@" --cwd "$cwd"
  "$HERDR" "$@" >/dev/null 2>&1
  snapshot | jq -r --argjson b "$before" --arg w "$target" \
    '([.tabs[] | select(.workspace_id == $w) | .tab_id] - $b)[0] // empty'
}

tab_root_pane() { # tab -> pane id
  snapshot | jq -r --arg t "$1" '[.panes[] | select(.tab_id == $t) | .pane_id][0] // empty'
}

# ----------------------------------------------------------------------------
# reopening what the panes were running
#
# herdr cannot start a pane on a command — `pane split` and `tab create` only
# take a cwd — so a pane is created as a shell and the command is typed into it
# afterwards with `pane run`. The shell buffers input from the moment it exists,
# so there is nothing to wait for.
#
# Source and rebuilt tab have the same geometry, so listing both tabs' panes in
# the same order pairs them off without having to track handles: position i in
# one is position i in the other.
# ----------------------------------------------------------------------------
tab_pane_ids() { # snap tab_id -> one pane id per line, top-to-bottom then left-to-right
  printf '%s' "$1" | jq -r --arg t "$2" '
    [.layouts[] | select(.tab_id == $t) | .panes[]]
    | sort_by(.rect.y, .rect.x) | .[].pane_id' 2>/dev/null
}

# What a pane is running, or empty if it is sitting at its shell prompt. The
# foreground process group leader is the command that was actually started; the
# rest of the group is its children, and a pane whose foreground process is the
# shell itself has nothing to reopen. Always prints exactly one line, so a herdr
# that fails to answer costs one pane its command instead of shifting every
# command in the tab onto the wrong pane.
pane_command() { # pane_id
  cmd=$("$HERDR" pane process-info --pane "$1" 2>/dev/null | jq -r '
    .result.process_info as $p
    | [$p.foreground_processes[]? | select(.pid != $p.shell_pid)] as $fg
    | if ($fg | length) == 0 then ""
      else ((first($fg[] | select(.pid == $p.foreground_process_group_id)) // $fg[0]).cmdline // "")
      end
    # One command per line downstream, and a control character has no business
    # being typed into a shell.
    | gsub("[[:cntrl:]]"; " ") | sub("^ +"; "") | sub(" +$"; "")' 2>/dev/null) || cmd=''
  printf '%s\n' "$cmd"
}

tab_commands() { # snap tab_id -> JSON array of commands, one per pane, in pane order
  ids=$(tab_pane_ids "$1" "$2")
  [ -n "$ids" ] || { printf '[]'; return 0; }
  printf '%s\n' "$ids" \
  | while IFS= read -r p; do
      [ -n "$p" ] || continue
      pane_command "$p"
    done \
  | jq -R -s -c 'rtrimstr("\n") | split("\n")' 2>/dev/null
}

run_commands() { # tab_id json_commands
  ncmd=$(printf '%s' "$2" | jq 'length' 2>/dev/null) || return 0
  [ "${ncmd:-0}" -gt 0 ] 2>/dev/null || return 0
  panes=$(tab_pane_ids "$(snapshot)" "$1")
  npane=$(printf '%s\n' "$panes" | grep -c '[^[:space:]]')
  # A tab that came out with a different number of panes — a split that failed,
  # say — has no reliable pairing left, and typing a command into the wrong pane
  # is worse than typing none.
  if [ "$npane" -ne "$ncmd" ]; then
    log "not reopening in $1: $npane panes for $ncmd commands"
    return 0
  fi
  i=0
  printf '%s\n' "$panes" | while IFS= read -r p; do
    [ -n "$p" ] || continue
    cmd=$(printf '%s' "$2" | jq -r --argjson i "$i" '.[$i] // ""' 2>/dev/null)
    i=$((i + 1))
    [ -n "$cmd" ] || continue
    log "reopen in $p: $cmd"
    "$HERDR" pane run "$p" "$cmd" >/dev/null 2>&1 || log "reopen failed in $p"
  done
}

split_pane() { # target parent dir ratio cwd -> new pane id
  target=$1; parent=$2; dir=$3; ratio=$4; cwd=${5:-}
  before=$(ws_pane_ids "$target")
  set -- pane split "$parent" --direction "$dir" --ratio "$ratio" --no-focus
  [ -n "$cwd" ] && set -- "$@" --cwd "$cwd"
  "$HERDR" "$@" >/dev/null 2>&1
  snapshot | jq -r --argjson b "$before" --arg w "$target" \
    '([.panes[] | select(.workspace_id == $w) | .pane_id] - $b)[0] // empty'
}

# ----------------------------------------------------------------------------
# clone: rebuild source's tab/pane geometry inside the fresh target workspace
# ----------------------------------------------------------------------------
# With $cwd set, every pane is spawned there instead of inheriting the target
# workspace's own directory.
do_clone() { # snap source target [cwd]
  snap=$1; source=$2; target=$3; cwd=${4:-}
  plan=$(jq -n --argjson snap "$snap" --arg ws "$source" -f "$PLAN_JQ" 2>/dev/null)
  [ -n "$plan" ] || { log "no plan for $source"; return 0; }
  ntabs=$(printf '%s' "$plan" | jq 'length' 2>/dev/null)
  [ "${ntabs:-0}" -gt 0 ] 2>/dev/null || { log "empty plan for $source"; return 0; }

  # lib/plan.jq is geometry only, by contract, and knows nothing about which tab
  # a plan entry came from. Pair them up here instead: same filter, same order.
  reopen=0
  if apps_enabled; then
    # Never overwrite the plan with a failed enrichment: a clone without its
    # commands is a small loss, a clone without its tabs is the whole feature.
    enriched=$(jq -n --argjson plan "$plan" --argjson snap "$snap" --arg w "$source" '
      [$snap.tabs[] | select(.workspace_id == $w) | .tab_id] as $ids
      | [range($plan | length) | $plan[.] + {source_tab: $ids[.]}]' 2>/dev/null)
    if [ -n "$enriched" ]; then plan=$enriched; reopen=1; fi
  fi
  reopening=''
  [ "$reopen" -eq 1 ] && reopening=', reopening apps'
  log "clone $source -> $target ($ntabs tabs)${cwd:+ in $cwd}$reopening"

  # Display order, not .number — see lib/plan.jq. (A fresh target has exactly one
  # tab, so this only matters if that ever stops being true.)
  root_tab=$(snapshot | jq -r --arg w "$target" '[.tabs[] | select(.workspace_id == $w)][0].tab_id')

  i=0
  printf '%s' "$plan" | jq -c '.[]' | while IFS= read -r tab; do
    label=$(printf '%s' "$tab" | jq -r '.label // ""')
    # Ask the source tab what it is running before building anything, so the
    # commands come from the workspace being cloned rather than from the panes
    # this loop is about to create.
    cmds='[]'
    if [ "$reopen" -eq 1 ]; then
      src_tab=$(printf '%s' "$tab" | jq -r '.source_tab // ""')
      [ -n "$src_tab" ] && cmds=$(tab_commands "$snap" "$src_tab")
    fi
    # Normally the first tab reuses the workspace's existing root tab. That pane
    # is already running in the workspace's own directory and can't be respawned
    # elsewhere, so when a directory was chosen every tab is created fresh and
    # the root tab is closed once they exist.
    if [ "$i" -eq 0 ] && [ -z "$cwd" ]; then
      cur_tab=$root_tab
      cur_pane=$(snapshot | jq -r --arg t "$root_tab" '[.panes[] | select(.tab_id == $t) | .pane_id][0] // empty')
      [ -n "$label" ] && "$HERDR" tab rename "$root_tab" "$label" >/dev/null 2>&1
    else
      new_tab=$(create_tab "$target" "$label" "$cwd")
      [ -n "$new_tab" ] || { log "tab create failed"; i=$((i + 1)); continue; }
      cur_tab=$new_tab
      cur_pane=$(tab_root_pane "$new_tab")
    fi
    [ -n "$cur_pane" ] || { log "no root pane for tab $i"; i=$((i + 1)); continue; }

    # Replay split steps. Pane handles live in eval'd vars H0, H1, ...; they
    # persist across iterations within this single subshell (the `while` pipe).
    eval "H0=\$cur_pane"
    printf '%s' "$tab" | jq -c '.steps[]?' | while IFS= read -r step; do
      p=$(printf '%s'  "$step" | jq -r '.parent')
      d=$(printf '%s'  "$step" | jq -r '.dir')
      r=$(printf '%s'  "$step" | jq -r '.ratio')
      c=$(printf '%s'  "$step" | jq -r '.child')
      eval "pp=\$H$p"
      # shellcheck disable=SC2154  # pp is assigned by the eval on the line above
      np=$(split_pane "$target" "$pp" "$d" "$r" "$cwd")
      if [ -n "$np" ]; then
        eval "H$c=\$np"
      else
        log "split failed parent=$pp $d $r"
      fi
    done

    # The tab is fully split now, so its panes are in their final positions and
    # can be paired with the ones they were cloned from.
    [ "$cmds" = '[]' ] || run_commands "$cur_tab" "$cmds"
    i=$((i + 1))
  done
  # The rebuilt tabs are all in place, so the original root tab (still sitting in
  # the workspace's own directory) has done its job.
  [ -n "$cwd" ] && "$HERDR" tab close "$root_tab" >/dev/null 2>&1

  # Show the first tab — but only if the user is already on this workspace, so a
  # workspace built in the background (CLI create) never steals their focus.
  first_tab=$(snapshot | jq -r --arg w "$target" \
    '[.tabs[] | select(.workspace_id == $w)][0].tab_id // empty')
  if [ -n "$first_tab" ] && \
     [ "$(snapshot | jq -r '.focused_workspace_id // empty')" = "$target" ]; then
    "$HERDR" tab focus "$first_tab" >/dev/null 2>&1 || true
  fi
}

# A claim guards the brief build window so overlapping events for the same new
# workspace don't clone it twice. It is released once the build finishes — the
# durable "already done" guard is ws_is_fresh (a built workspace is no longer
# fresh), so claims are not meant to outlive the work they guard.
claim_name() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }
claim_dir()  { printf '%s/claimed/%s' "$STATE" "$(claim_name "$1")"; }
claim()   { mkdir "$(claim_dir "$1")" 2>/dev/null; }   # atomic; non-zero if held
unclaim() { rmdir "$(claim_dir "$1")" 2>/dev/null || true; }

# One way out doesn't release its claim: a popup whose workspace is closed from
# somewhere else is orphaned rather than signalled — its trap never runs, and it
# sits blocked on a read that will never return. herdr recycles short workspace
# ids, so that leftover claim would silently stop the next workspace given the
# same id from ever being cloned into. Drop claims whose workspace is gone, the
# same way the populated-workspace history drops ids that no longer exist.
sweep_claims() { # snap
  live=$(printf '%s' "$1" | jq -r '.workspaces[].workspace_id' 2>/dev/null) || return 0
  # An empty list means the snapshot failed, not that every workspace closed —
  # sweeping on that would release claims that are still guarding a live build.
  [ -n "$live" ] || return 0
  keep=$(printf '%s\n' "$live" | while IFS= read -r w; do
    [ -n "$w" ] && claim_name "$w"
  done)
  for held in "$STATE"/claimed/*; do
    [ -d "$held" ] || continue
    name=${held##*/}
    printf '%s\n' "$keep" | grep -qxF "$name" && continue
    log "dropping stale claim $name"
    rmdir "$held" 2>/dev/null || true
  done
}

# Populate a workspace that has just appeared or been focused, if it is a fresh
# (1-tab/1-pane) workspace and a populated source is known. The claim is taken
# only once we're about to clone, so: overlapping events for the same new
# workspace dedupe (loser bails), yet a focus with no source yet stays eligible
# to be cloned on a later event once a source exists.
try_populate() { # new_ws
  new=$1
  [ -n "$new" ] || return 0
  snap=$(snapshot)
  remember_populated "$snap"
  sweep_claims "$snap"
  ws_known "$new" && { log "$new has held a layout before, skip"; return 0; }
  ws_is_fresh "$snap" "$new" || { log "$new not fresh, skip"; return 0; }
  source=$(pick_source "$snap" "$new")
  [ -n "$source" ] || { log "no source to clone for $new"; return 0; }
  claim "$new" || { log "already claimed $new"; return 0; }
  # A worktree arrives with three events at once — workspace.created,
  # worktree.created and workspace.focused, inside a couple of milliseconds — so
  # whichever handler won the claim above may have read its snapshot before the
  # focus landed on the new workspace. It holds the claim, so nothing is racing
  # it any more: give the focus a moment and look again. Without this the popup
  # would appear or not depending on which of the three events got there first.
  if ws_is_worktree "$snap" "$new" && ! ws_is_focused "$snap" "$new"; then
    settle
    snap=$(snapshot)
  fi
  if should_prompt "$snap" "$new"; then
    # The dialog takes over from here: it owns the claim and does the cloning
    # itself, so this hook returns immediately rather than blocking herdr for as
    # long as the user takes to answer.
    open_dialog "$snap" "$source" "$new" && return 0
    log "could not open dialog for $new, cloning directly"
  fi
  # Nobody is being asked on this path, so honour the box the dialog last left
  # unticked. The workspace isn't recorded as done: leave it eligible, so
  # ticking the box back on still catches it while it is untouched.
  if ! clone_enabled; then
    log "clone layout is off, leaving $new alone"
    unclaim "$new"
    return 0
  fi
  do_clone "$snap" "$source" "$new"
  # Record it now rather than waiting for the next event's remember_populated:
  # an overlapping hook may snapshot before these tabs are visible.
  printf '%s\n' "$new" >>"$KNOWN_FILE" 2>/dev/null || true
  unclaim "$new"
}

# Who gets the dialog: a new workspace — worktree or not — that the user is
# actually looking at. A worktree's directory is settled, but the two boxes are
# not, and the popup is the only place they can be changed. One built in the
# background (scripted `herdr workspace create`) has nobody at the keyboard to
# answer, so it clones straight away, exactly as before.
should_prompt() { # snap ws
  [ ! -f "$NOPROMPT_FILE" ] || return 1
  ws_is_focused "$1" "$2"
}

open_dialog() { # snap source target
  dir=$(ws_dir "$1" "$2")
  # What the popup calls the thing it is asking about, and what cancelling it is
  # allowed to do: a worktree is never thrown away, a plain workspace is.
  kind=workspace
  ws_is_worktree "$1" "$3" && kind=worktree
  log "prompt for $3 ($kind, source $2, dir ${dir:-unknown})"
  # `plugin pane open` does take --workspace and --target-pane, but neither is
  # needed: a popup with no target goes to the active pane, and should_prompt
  # only fires for the focused workspace, so the active pane is already there.
  "$HERDR" plugin pane open \
    --plugin "${HERDR_PLUGIN_ID:-herdr-clone-layout}" \
    --entrypoint choose-layout \
    --env "CLONE_LAYOUT_TARGET=$3" \
    --env "CLONE_LAYOUT_FROM=$2" \
    --env "CLONE_LAYOUT_DIR=$dir" \
    --env "CLONE_LAYOUT_KIND=$kind" \
    --focus >/dev/null 2>&1
}

# ----------------------------------------------------------------------------
# entrypoints
# ----------------------------------------------------------------------------
# Test hook: `CLONE_LAYOUT_SOURCE=1 . bin/clone-layout` loads the functions
# without running an entrypoint.
if [ "${CLONE_LAYOUT_SOURCE:-}" = "1" ]; then return 0; fi

# jq does the whole geometry analysis; without it the plugin can do nothing.
if ! command -v jq >/dev/null 2>&1; then
  printf 'herdr-clone-layout: jq not found on PATH — install jq (https://jqlang.github.io/jq/)\n' >&2
  exit 1
fi

trim_log

mode=${1:-event}
case "$mode" in
  event)
    ev=$(printf '%s' "${HERDR_PLUGIN_EVENT_JSON:-}" | jq -r '.event // empty' 2>/dev/null)
    ws=$(printf '%s' "${HERDR_PLUGIN_EVENT_JSON:-}" | jq -r \
        '.data.workspace_id // .data.workspace.workspace_id // empty' 2>/dev/null)
    case "$ev" in
      # Record the newly-focused workspace, then try to populate it: the TUI
      # "new worktree/workspace" path emits ONLY workspace.focused (it focuses
      # the new one), so cloning has to happen here too. pick_source skips the
      # new id and finds the previously-focused workspace as the clone source.
      workspace_focused|workspace.focused) record_focus "$ws"; try_populate "$ws" ;;
      # CLI path: the new workspace isn't focused yet, so the still-focused
      # source is found via .focused_workspace_id inside pick_source.
      workspace_created|workspace.created|worktree_created|worktree.created) try_populate "$ws" ;;
      *) : ;;
    esac
    ;;
  apply)
    # Duplicate the current workspace into a new one. Invoking this IS the ask,
    # so the dialog's checkbox doesn't gate it and isn't changed by it.
    snap=$(snapshot)
    source=$(printf '%s' "$snap" | jq -r '.focused_workspace_id // empty')
    [ -n "$source" ] || exit 0
    before=$(snapshot | jq -c '[.workspaces[].workspace_id]')
    # "Duplicate this layout" is already an answer to the question the dialog
    # asks, so silence it for the workspace this is about to create. The flag is
    # global because the new id isn't known until after the create returns, by
    # which time the hooks have already fired.
    : >"$NOPROMPT_FILE" 2>/dev/null || true
    trap 'rm -f "$NOPROMPT_FILE"' EXIT INT TERM
    "$HERDR" workspace create --focus >/dev/null 2>&1
    new=$(snapshot | jq -r --argjson b "$before" '([.workspaces[].workspace_id] - $b)[0] // empty')
    [ -n "$new" ] || exit 0
    if claim "$new"; then
      # `workspace create --focus` fires workspace.created/focused, so the event
      # hooks are racing to build this same workspace. If one of them got there
      # first, don't stack a second copy of the layout on top of it.
      if ws_is_fresh "$(snapshot)" "$new"; then
        do_clone "$(snapshot)" "$source" "$new"
        printf '%s\n' "$new" >>"$KNOWN_FILE" 2>/dev/null || true
      else
        log "$new already built, skip duplicate apply"
      fi
      unclaim "$new"
      "$HERDR" workspace focus "$new" >/dev/null 2>&1 || true
    fi
    ;;
  *) printf 'usage: %s [event|apply]\n' "$0" >&2; exit 2 ;;
esac
