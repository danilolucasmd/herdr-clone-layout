#!/usr/bin/env sh
# herdr-clone-layout — the popup a new workspace or worktree gets, asking whether
# to clone the previous workspace's layout as-is, to clone it with every pane
# opened in a directory you choose, or — with the first checkbox unticked — not at
# all. A second checkbox decides whether each pane reopens the command it was
# running. Both boxes are remembered for the next one.
#
# A worktree is only asked the first of those: its directory was settled when the
# checkout was made, and the layout worth having there is the one you came from,
# panes and all — each one in the directory it was in, read off the new checkout
# rather than the old one. So the directory answer is a new-workspace question.
#
# Cancelling closes a plain new workspace, since nothing has been put in it yet.
# A worktree is left alone: it is a checkout on disk with a branch of its own.
#
# herdr runs this as a popup plugin pane (see [[panes]] in herdr-plugin.toml),
# so stdin is a tty and the process owning the popup is this script: the popup
# closes when it exits. The event hook hands over the claim on the new
# workspace, so this script is what finishes the job — including releasing that
# claim on every exit path.
#
# Env from the hook: CLONE_LAYOUT_TARGET (new workspace), CLONE_LAYOUT_FROM
# (workspace to clone), CLONE_LAYOUT_DIR (its directory — named on screen, and
# offered to open the panes in), CLONE_LAYOUT_KIND (workspace or worktree).
#
# Deps: herdr CLI + jq. POSIX sh.

set -u

ROOT=${HERDR_PLUGIN_ROOT:-$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)}

# Reuse the hook's snapshot/clone/claim/log machinery rather than a second copy.
CLONE_LAYOUT_SOURCE=1
export CLONE_LAYOUT_SOURCE
# Path is only known at runtime, and CI lints bin/clone-layout directly anyway.
# shellcheck disable=SC1091
. "$ROOT/bin/clone-layout"
unset CLONE_LAYOUT_SOURCE

TARGET=${CLONE_LAYOUT_TARGET:-}
FROM=${CLONE_LAYOUT_FROM:-}
DIR=${CLONE_LAYOUT_DIR:-}
# "workspace" or "worktree" — what is being asked about: the wording, and whether
# the directory row is part of the question at all. What may be closed on the way
# out is decided from the snapshot instead, so a stale or missing value costs at
# worst a row nobody needed, never a checkout.
KIND=${CLONE_LAYOUT_KIND:-workspace}

# ----------------------------------------------------------------------------
# terminal handling
# ----------------------------------------------------------------------------
STTY_SAVE=$(stty -g 2>/dev/null || echo '')

restore() {
  if [ -n "$STTY_SAVE" ]; then
    stty "$STTY_SAVE" 2>/dev/null || true
  else
    stty sane 2>/dev/null || true
  fi
  printf '\033[?25h'   # cursor back on
}

# Whatever happens — answered, cancelled, killed, crashed — the claim must not
# outlive this popup, or the workspace stays unbuilt and un-buildable.
cleanup() {
  restore
  unclaim "$TARGET"
}

# ----------------------------------------------------------------------------
# cancelling
# ----------------------------------------------------------------------------
# Is the new workspace still the empty thing this popup was opened about? The
# popup doesn't hold the keyboard hostage — you can switch away, do something in
# the workspace and come back — and a workspace with someone's work in it is not
# ours to close, however they got there.
discardable() { # ws
  snap=$(snapshot)
  # A worktree is a git checkout on disk with a branch of its own. Cancelling a
  # popup is nowhere near reason enough to throw that away, so it stays and only
  # the popup closes.
  if ws_is_worktree "$snap" "$1"; then
    log "dialog: $1 is a worktree, keeping it"
    return 1
  fi
  if ! ws_is_fresh "$snap" "$1"; then
    log "dialog: $1 is not empty any more, keeping it"
    return 1
  fi
  pane=$(printf '%s' "$snap" | jq -r --arg w "$1" \
    '[.panes[] | select(.workspace_id == $w) | .pane_id][0] // empty' 2>/dev/null)
  [ -n "$pane" ] || return 1
  busy=$(pane_command "$pane")
  if [ -n "$busy" ]; then
    log "dialog: $1 is running $busy, keeping it"
    return 1
  fi
  return 0
}

# Esc (and ctrl-d) mean "I didn't want this one after all", so the workspace
# herdr just made goes with it rather than being left behind empty.
cancel() {
  log "dialog: cancelled for $TARGET"
  restore
  # Let go of the claim first: this popup is attached to a pane in the workspace
  # it is about to close, so it may not outlive the request.
  unclaim "$TARGET"
  if [ -n "$TARGET" ] && discardable "$TARGET"; then
    log "dialog: closing $TARGET"
    "$HERDR" workspace close "$TARGET" >/dev/null 2>&1 || log "dialog: could not close $TARGET"
  else
    # It is staying — a worktree, or something that isn't empty any more. Record
    # it as settled: it is still one tab and one pane, which is all "fresh"
    # means, so without this the popup would open again the next time it is
    # focused and keep asking a question already answered with Esc.
    printf '%s\n' "$TARGET" >>"$KNOWN_FILE" 2>/dev/null || true
  fi
  exit 0
}

raw_mode() { stty raw -echo min 1 time 0 2>/dev/null; }

# Reads one raw byte into $key (empty at EOF).
#
# Both of these assign to a variable instead of echoing their result, and both
# pad with a sentinel before stripping it back off. Command substitution eats
# trailing newlines, so `key=$(readkey)` around a function that echoes would eat
# the Enter key no matter how carefully the function itself preserved it.
readkey() {
  key=$(dd bs=1 count=1 2>/dev/null; printf X)
  key=${key%X}
}

# After an ESC, peek into $seq for the rest of an arrow sequence. A bare Esc
# leaves nothing to read, and min 0 time 1 gives up after 0.1s instead of
# blocking forever waiting for a second byte that isn't coming.
peek_seq() {
  stty min 0 time 1 2>/dev/null
  seq=$(dd bs=1 count=2 2>/dev/null; printf X)
  stty min 1 time 0 2>/dev/null
  seq=${seq%X}
}

# ----------------------------------------------------------------------------
# paths
# ----------------------------------------------------------------------------
expand_path() { # display form -> absolute
  # The tildes here are literal text being matched and stripped, not something
  # to expand, so shellcheck's "use $HOME" note doesn't apply.
  # shellcheck disable=SC2088
  case "$1" in
    '~')   printf '%s' "$HOME" ;;
    '~/'*) printf '%s%s' "$HOME" "${1#\~}" ;;
    *)     printf '%s' "$1" ;;
  esac
}

abbrev_path() { # absolute -> display form
  case "$1" in
    "$HOME")   printf '~' ;;
    "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;;
    *)         printf '%s' "$1" ;;
  esac
}

# Take back one path segment of $input — everything after the last slash, and
# the slash with it. This is Ctrl-W's unit: the big one, a whole directory name
# however it is punctuated.
kill_segment() {
  input=${input%"${input##*/}"}   # back to the last /
  input=${input%/}
}

# Take back one word of $input, the way a shell's backward-kill-word does: any
# punctuation sitting at the end goes first, then the run of letters and digits
# in front of it. Everything that is not a letter or a digit is a boundary, so
# /test-test loses "test" and stops on the hyphen, then loses "test-" and stops
# on the slash. This is the smaller unit, and the one ctrl-backspace gets: a
# path is edited a name at a time with Ctrl-W and a piece of a name at a time
# with this.
kill_word() {
  # the punctuation behind the cursor: the hyphen, the slash, the dot
  while [ -n "$input" ]; do
    case "$input" in
      *[[:alnum:]]) break ;;
      *) input=${input%?} ;;
    esac
  done
  # then the word it was hanging off
  while [ -n "$input" ]; do
    case "$input" in
      *[[:alnum:]]) input=${input%?} ;;
      *) break ;;
    esac
  done
}

# Cut a line down to what the popup is wide enough for.
fit() { # text
  if [ "${#1}" -gt 58 ]; then printf '%.57s…' "$1"; else printf '%s' "$1"; fi
}

# Tab completion for the directory field, against what is on disk. Directories
# only: a directory is the only answer this field can take, so offering files
# would only ever be offering wrong ones. One match is filled in whole with its
# slash, so the next Tab walks straight into it; several are filled in as far as
# they agree and then named underneath, which is all the room there is to show
# them in; none leaves what was typed alone and says so.
complete_path() { # edits $input, sets $note
  # The stub is split off the display form rather than the expanded one, so what
  # is put back is in the form it was typed in — completing "~/Co" must not turn
  # the field into /home/you/Code behind your back. That is also why the tilde
  # below is a literal one and not $HOME: it is the text going back on screen,
  # and expand_path is what turns it into a directory to look in.
  # shellcheck disable=SC2088
  case "$input" in
    */*) stub=${input##*/}; head=${input%"$stub"} ;;
    '~') stub=''; head='~/' ;;   # inside home, not alongside it
    *)   stub=$input; head='' ;;
  esac
  dir=$(expand_path "$head")
  [ -n "$dir" ] || dir=./        # a bare name completes where the popup is

  matches=0
  common=''
  listed=''
  for entry in "$dir$stub"*/; do
    # A glob that matched nothing comes back as itself, and the trailing slash
    # is what keeps this to directories — a symlink to one included.
    [ -d "$entry" ] || continue
    name=${entry%/}
    name=${name##*/}
    matches=$((matches + 1))
    if [ "$matches" -eq 1 ]; then
      common=$name
    else
      # Trim what the matches so far agree on to what this one agrees with too.
      # $common is quoted inside the pattern, so a directory named with a
      # bracket or a star is matched as the name it is.
      while [ -n "$common" ]; do
        case "$name" in "$common"*) break ;; esac
        common=${common%?}
      done
    fi
    listed="$listed  $name"
  done

  if [ "$matches" -eq 0 ]; then
    if [ -n "$stub" ]; then
      note=$(fit "no directory starting with $stub")
    else
      note=$(fit "no directories in $(abbrev_path "$dir")")
    fi
    return
  fi
  if [ "$matches" -eq 1 ]; then
    input="$head$common/"
    return
  fi
  # As far as they agree, and then the names themselves — including when they
  # agree on nothing more, which is exactly when the names are what is wanted.
  input="$head$common"
  note=$(fit "${listed#  }")
}

# ----------------------------------------------------------------------------
# rendering
# ----------------------------------------------------------------------------
B=$(printf '\033[1m')      # bold
D=$(printf '\033[2m')      # dim
C=$(printf '\033[36m')     # cyan
R=$(printf '\033[0m')      # reset
REV=$(printf '\033[7m')    # reverse (the input cursor)

row=0        # 0 = clone as-is, then the directory input, then the checkboxes
# A worktree is a checkout of its own, made where it was made, and cloning the
# layout you came from is the whole point of copying it there — panes included.
# Opening them somewhere else is a question about a new workspace, not about a
# worktree, so the row is left out and everything below it moves up. DIR_ROW is
# then a row number nothing can ever be on, which is what the key handling below
# tests against instead of a literal 1.
if [ "$KIND" = worktree ]; then
  DIR_ROW=-1
  CLONE_ROW=1
else
  DIR_ROW=1
  CLONE_ROW=2
fi
APPS_ROW=$((CLONE_ROW + 1))
LAST_ROW=$APPS_ROW   # up/down clamp against it

# The checkboxes are rows of their own, below the directory answers rather than
# mixed in with them: the answers above decide *where* the panes open, the boxes
# below decide *what* a clone is. Unticking the first one means nothing is
# cloned at all, so Enter from any row leaves the new workspace as herdr opened
# it; the second one decides whether each pane reopens the command it had. Both
# are remembered, so the boxes open the way they were left.
input=$(abbrev_path "$DIR")
err=''
note=''      # what Tab has to say: the matches, or that there are none

enabled=1
clone_enabled || enabled=0
apps=1
apps_enabled || apps=0

checkbox() { # 1|0
  if [ "$1" -eq 1 ]; then printf '[x]'; else printf '[ ]'; fi
}

# One selectable row: the cursor marks the row you are on, and its label is bold
# there, dim elsewhere. While the first box is unticked everything above it is
# dim even when selected — those rows stay reachable, since confirming still
# happens on them, but nothing they describe is going to happen.
row_label() { # row_index label
  if [ "$row" -ne "$1" ]; then
    printf '    %s%s%s\r\n' "$D" "$2" "$R"
  elif [ "$enabled" -eq 0 ] && [ "$1" -lt "$CLONE_ROW" ]; then
    printf '  %s>%s %s%s%s\r\n' "$C" "$R" "$D" "$2" "$R"
  else
    printf '  %s>%s %s%s%s\r\n' "$C" "$R" "$B" "$2" "$R"
  fi
}

render() {
  printf '\033[H\033[2J\033[?25l'
  printf '  %snew %s%s\r\n\r\n' "$B" "$KIND" "$R"

  row_label 0 'clone current layout'
  if [ "$enabled" -eq 1 ]; then
    # A worktree is the same tree under a different root, so its panes come over
    # with the directories they were in — say so, since it is the difference
    # between a pane at the top of the checkout and the one it was cloned from.
    if [ "$KIND" = worktree ]; then
      printf '      %sthe same tabs, splits and pane directories as %s%s\r\n\r\n' \
        "$D" "$(abbrev_path "$DIR")" "$R"
    else
      printf '      %sthe same tabs and splits as %s%s\r\n\r\n' "$D" "$(abbrev_path "$DIR")" "$R"
    fi
  else
    # This line describes what row 0 would do, so it is the right place to say
    # that the box below has taken it off the table — and what Enter does now
    # instead, which the key hints have no room left for.
    printf '      %snothing is cloned. enter leaves this %s empty%s\r\n\r\n' "$D" "$KIND" "$R"
  fi

  if [ "$DIR_ROW" -ge 0 ]; then
    row_label "$DIR_ROW" 'panes open in'
    if [ "$row" -eq "$DIR_ROW" ]; then
      printf '    %s%s %s\r\n\r\n' "$input" "$REV" "$R"
    else
      printf '    %s%s%s\r\n\r\n' "$D" "$input" "$R"
    fi
  fi

  # A heading for the pair, so the boxes read as settings rather than as two more
  # answers to the question above them.
  printf '    %soptions%s\r\n' "$D" "$R"
  row_label "$CLONE_ROW" "$(checkbox "$enabled") clone layouts into new workspaces"
  row_label "$APPS_ROW"  "$(checkbox "$apps") reopen the apps each pane was running"
  printf '\r\n'

  if [ -n "$err" ]; then
    printf '  %s%s%s\r\n' "$(printf '\033[31m')" "$err" "$R"
  elif [ -n "$note" ]; then
    # What Tab found, in the line the key hints would otherwise have. It is
    # gone again on the next keypress, so the hints are never far away.
    printf '  %s%s%s\r\n' "$D" "$note" "$R"
  elif [ "$row" -eq "$DIR_ROW" ]; then
    printf '  %s^ v switch    tab complete    enter confirm    esc cancel%s\r\n' "$D" "$R"
  elif [ "$row" -lt "$CLONE_ROW" ]; then
    # Space only belongs to the row it is standing on, and with two boxes there
    # is no sensible box for it to toggle from the rows above them.
    printf '  %s^ v switch    enter confirm    esc cancel%s\r\n' "$D" "$R"
  else
    printf '  %s^ v switch    space toggle    enter confirm    esc cancel%s\r\n' "$D" "$R"
  fi
}

# ----------------------------------------------------------------------------
# the clone, once an answer is in
# ----------------------------------------------------------------------------
finish() { # [cwd]
  # Confirming is what gets both boxes remembered — written here rather than on
  # the keypress, so an Enter that only produced "no such directory" hasn't
  # quietly decided anything. do_clone reads the apps box back out of the state
  # dir, so it has to be written before the clone starts.
  remember "$CLONE_BOX" 1
  remember "$APPS_BOX" "$apps"
  restore
  printf '\033[H\033[2J\r\n  building layout...\r\n'
  do_clone "$(snapshot)" "$FROM" "$TARGET" "${1:-}"
  printf '%s\n' "$TARGET" >>"$KNOWN_FILE" 2>/dev/null || true
  exit 0
}

# ----------------------------------------------------------------------------
# main loop
# ----------------------------------------------------------------------------
# Assigns by name for the same reason readkey does: `LF=$(ctrl '\n')` would put
# the empty string in LF, and Enter would then be compared against "" and never
# match — the dialog would sit there ignoring the key that confirms it.
ctrl() { # varname escape
  # shellcheck disable=SC2034  # read back by the eval below
  c=$(printf '%bX' "$2")
  eval "$1=\${c%X}"
}
# Octals take printf's %b form, with the leading zero: plain '\177' comes back
# as four literal characters, which would quietly stop Delete from working.
ctrl CR  '\r'
ctrl LF  '\n'
ctrl TAB '\t'
ctrl ESC '\0033'
ctrl BS  '\0010'
ctrl DEL '\0177'
ctrl NAK '\0025'   # ctrl-u
ctrl ETB '\0027'   # ctrl-w
ctrl EOT '\0004'   # ctrl-d

# Test hook: `CLONE_LAYOUT_DIALOG_SOURCE=1 . bin/clone-layout-dialog` loads the
# helpers without taking over the terminal.
if [ "${CLONE_LAYOUT_DIALOG_SOURCE:-}" = "1" ]; then return 0; fi

# Nothing to ask about without a workspace to build and one to copy.
[ -n "$TARGET" ] && [ -n "$FROM" ] || exit 0

trap 'cleanup' EXIT
trap 'cleanup; exit 130' INT TERM HUP

raw_mode
render
empty=0
while :; do
  readkey
  if [ -z "$key" ]; then
    # Nothing to read: normally a stray NUL, but a closed stdin would spin here
    # forever, so give up rather than pin a core.
    empty=$((empty + 1))
    [ "$empty" -lt 100 ] || { log "dialog: stdin closed for $TARGET"; exit 0; }
    continue
  fi
  empty=0
  err=''
  note=''

  case "$key" in
    "$CR" | "$LF")
      if [ "$enabled" -eq 0 ]; then
        # A deliberate no. Remember both boxes for the next workspace, and record
        # this one as done so simply switching back to it doesn't ask all over
        # again — it is still 1 tab and 1 pane, which is all "fresh" means.
        remember "$CLONE_BOX" 0
        remember "$APPS_BOX" "$apps"
        log "dialog: clone off, leaving $TARGET as it is"
        printf '%s\n' "$TARGET" >>"$KNOWN_FILE" 2>/dev/null || true
        restore
        exit 0
      fi
      # Only the directory row asks for a directory; confirming from row 0 or
      # from the box itself clones as-is — as does every row of a worktree's
      # popup, which has no directory row at all.
      if [ "$row" -ne "$DIR_ROW" ]; then
        log "dialog: clone $FROM -> $TARGET as-is"
        finish
      fi
      target_dir=$(expand_path "$input")
      if [ -z "$target_dir" ]; then
        err='enter a directory'
      elif [ ! -d "$target_dir" ]; then
        err="no such directory: $(abbrev_path "$target_dir")"
      else
        log "dialog: clone $FROM -> $TARGET in $target_dir"
        finish "$target_dir"
      fi
      ;;
    "$ESC")
      peek_seq
      case "$seq" in
        '[A') [ "$row" -gt 0 ] && row=$((row - 1)) ;;            # up
        '[B') [ "$row" -lt "$LAST_ROW" ] && row=$((row + 1)) ;;   # down
        # Alt-backspace, and the terminals that spell ctrl-backspace this way.
        # Alt-backspace is backward-kill-word in a shell too, so it is the same
        # unit here as the key it stands in for.
        "$DEL" | "$BS") [ "$row" -eq "$DIR_ROW" ] && kill_word ;;
        '') cancel ;;                        # bare Esc
        *) : ;;                              # some other sequence, ignore
      esac
      ;;
    "$EOT") cancel ;;                        # ctrl-d, same as cancelling
    "$DEL")                                  # backspace: one character
      [ "$row" -eq "$DIR_ROW" ] && input=${input%?}
      ;;
    "$NAK")
      [ "$row" -eq "$DIR_ROW" ] && input=''
      ;;
    "$ETB")                                  # ctrl-w: a whole path segment
      [ "$row" -eq "$DIR_ROW" ] && kill_segment
      ;;
    "$BS")
      # Ctrl-backspace. A terminal sends 0177 for backspace and 010 for
      # ctrl-backspace, so the two arrive as different bytes and the modifier can
      # mean what it means everywhere else: a word, punctuation-delimited, rather
      # than a character. (A terminal configured the other way round, with plain
      # backspace on 010, deletes a word at a time here.)
      [ "$row" -eq "$DIR_ROW" ] && kill_word
      ;;
    ' ')
      # Space ticks the box you are standing on. On the directory row it is an
      # ordinary character instead — directory names do contain spaces. On the
      # top row it does nothing: with two boxes there is no one box for it to
      # mean, and silently appending a space to a path you can't see being
      # edited would be worse than asking you to be on the box you want.
      if [ "$row" -eq "$DIR_ROW" ]; then
        input="$input$key"
      elif [ "$row" -eq "$CLONE_ROW" ]; then
        if [ "$enabled" -eq 1 ]; then enabled=0; else enabled=1; fi
      elif [ "$row" -eq "$APPS_ROW" ]; then
        if [ "$apps" -eq 1 ]; then apps=0; else apps=1; fi
      fi
      ;;
    "$TAB")
      # Tab completes the path when there is a path under it, and cycles the
      # rows everywhere else — completing is what the key is for in a field, and
      # the field is not a trap: up and down still leave it, and the hint line
      # under it says which Tab you are getting.
      if [ "$row" -eq "$DIR_ROW" ]; then
        complete_path
      else
        row=$(( (row + 1) % (LAST_ROW + 1) ))
      fi
      ;;
    *)
      # Printable input goes to the directory, and typing jumps you there so
      # the path is editable without reaching for the arrow keys first. With no
      # directory row there is nowhere for it to go, so it is dropped rather
      # than typed into a path nobody can see.
      case "$key" in
        [[:cntrl:]]) : ;;
        *)
          if [ "$DIR_ROW" -ge 0 ]; then
            row=$DIR_ROW
            input="$input$key"
          fi
          ;;
      esac
      ;;
  esac
  render
done
