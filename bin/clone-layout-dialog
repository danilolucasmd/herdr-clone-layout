#!/usr/bin/env sh
# herdr-clone-layout — the popup a plain new workspace gets, asking whether to
# clone the previous workspace's layout as-is, to clone it with every pane opened
# in a directory you choose, or — with the first checkbox unticked — not at all.
# A second checkbox decides whether each pane reopens the command it was running.
# Both boxes are remembered for the next new workspace.
#
# herdr runs this as a popup plugin pane (see [[panes]] in herdr-plugin.toml),
# so stdin is a tty and the process owning the popup is this script: the popup
# closes when it exits. The event hook hands over the claim on the new
# workspace, so this script is what finishes the job — including releasing that
# claim on every exit path.
#
# Env from the hook: CLONE_LAYOUT_TARGET (new workspace), CLONE_LAYOUT_FROM
# (workspace to clone), CLONE_LAYOUT_DIR (directory to offer).
#
# Deps: herdr CLI + jq. POSIX sh.

set -u

ROOT=${HERDR_PLUGIN_ROOT:-$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)}

# Reuse the hook's snapshot/clone/claim/log machinery rather than a second copy.
CLONE_LAYOUT_SOURCE=1
export CLONE_LAYOUT_SOURCE
# Path is only known at runtime, and CI lints bin/clone-layout directly anyway.
# shellcheck disable=SC1091
. "$ROOT/bin/clone-layout"
unset CLONE_LAYOUT_SOURCE

TARGET=${CLONE_LAYOUT_TARGET:-}
FROM=${CLONE_LAYOUT_FROM:-}
DIR=${CLONE_LAYOUT_DIR:-}

# ----------------------------------------------------------------------------
# terminal handling
# ----------------------------------------------------------------------------
STTY_SAVE=$(stty -g 2>/dev/null || echo '')

restore() {
  if [ -n "$STTY_SAVE" ]; then
    stty "$STTY_SAVE" 2>/dev/null || true
  else
    stty sane 2>/dev/null || true
  fi
  printf '\033[?25h'   # cursor back on
}

# Whatever happens — answered, cancelled, killed, crashed — the claim must not
# outlive this popup, or the workspace stays unbuilt and un-buildable.
cleanup() {
  restore
  unclaim "$TARGET"
}

raw_mode() { stty raw -echo min 1 time 0 2>/dev/null; }

# Reads one raw byte into $key (empty at EOF).
#
# Both of these assign to a variable instead of echoing their result, and both
# pad with a sentinel before stripping it back off. Command substitution eats
# trailing newlines, so `key=$(readkey)` around a function that echoes would eat
# the Enter key no matter how carefully the function itself preserved it.
readkey() {
  key=$(dd bs=1 count=1 2>/dev/null; printf X)
  key=${key%X}
}

# After an ESC, peek into $seq for the rest of an arrow sequence. A bare Esc
# leaves nothing to read, and min 0 time 1 gives up after 0.1s instead of
# blocking forever waiting for a second byte that isn't coming.
peek_seq() {
  stty min 0 time 1 2>/dev/null
  seq=$(dd bs=1 count=2 2>/dev/null; printf X)
  stty min 1 time 0 2>/dev/null
  seq=${seq%X}
}

# ----------------------------------------------------------------------------
# paths
# ----------------------------------------------------------------------------
expand_path() { # display form -> absolute
  # The tildes here are literal text being matched and stripped, not something
  # to expand, so shellcheck's "use $HOME" note doesn't apply.
  # shellcheck disable=SC2088
  case "$1" in
    '~')   printf '%s' "$HOME" ;;
    '~/'*) printf '%s%s' "$HOME" "${1#\~}" ;;
    *)     printf '%s' "$1" ;;
  esac
}

abbrev_path() { # absolute -> display form
  case "$1" in
    "$HOME")   printf '~' ;;
    "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;;
    *)         printf '%s' "$1" ;;
  esac
}

# ----------------------------------------------------------------------------
# rendering
# ----------------------------------------------------------------------------
B=$(printf '\033[1m')      # bold
D=$(printf '\033[2m')      # dim
C=$(printf '\033[36m')     # cyan
R=$(printf '\033[0m')      # reset
REV=$(printf '\033[7m')    # reverse (the input cursor)

row=0        # 0 = clone as-is, 1 = directory input, 2 and 3 = the checkboxes
CLONE_ROW=2
APPS_ROW=3
LAST_ROW=3   # up/down clamp against it

# The checkboxes are rows of their own, below the two directory answers rather
# than mixed in with them: the answers above decide *where* the panes open, the
# boxes below decide *what* a clone is. Unticking the first one means nothing is
# cloned at all, so Enter from any row leaves the new workspace as herdr opened
# it; the second one decides whether each pane reopens the command it had. Both
# are remembered, so the boxes open the way they were left.
input=$(abbrev_path "$DIR")
err=''

enabled=1
clone_enabled || enabled=0
apps=1
apps_enabled || apps=0

checkbox() { # 1|0
  if [ "$1" -eq 1 ]; then printf '[x]'; else printf '[ ]'; fi
}

# One selectable row: the cursor marks the row you are on, and its label is bold
# there, dim elsewhere. While the first box is unticked everything above it is
# dim even when selected — those rows stay reachable, since confirming still
# happens on them, but nothing they describe is going to happen.
row_label() { # row_index label
  if [ "$row" -ne "$1" ]; then
    printf '    %s%s%s\r\n' "$D" "$2" "$R"
  elif [ "$enabled" -eq 0 ] && [ "$1" -lt "$CLONE_ROW" ]; then
    printf '  %s>%s %s%s%s\r\n' "$C" "$R" "$D" "$2" "$R"
  else
    printf '  %s>%s %s%s%s\r\n' "$C" "$R" "$B" "$2" "$R"
  fi
}

render() {
  printf '\033[H\033[2J\033[?25l'
  printf '  %snew workspace%s\r\n\r\n' "$B" "$R"

  row_label 0 'clone current layout'
  if [ "$enabled" -eq 1 ]; then
    printf '      %sthe same tabs and splits as %s%s\r\n\r\n' "$D" "$(abbrev_path "$DIR")" "$R"
  else
    # This line describes what row 0 would do, so it is the right place to say
    # that the box below has taken it off the table — and what Enter does now
    # instead, which the key hints have no room left for.
    printf '      %snothing is cloned. enter leaves this workspace empty%s\r\n\r\n' "$D" "$R"
  fi

  row_label 1 'panes open in'
  if [ "$row" -eq 1 ]; then
    printf '    %s%s %s\r\n\r\n' "$input" "$REV" "$R"
  else
    printf '    %s%s%s\r\n\r\n' "$D" "$input" "$R"
  fi

  # A heading for the pair, so the boxes read as settings rather than as two more
  # answers to the question above them.
  printf '    %soptions%s\r\n' "$D" "$R"
  row_label "$CLONE_ROW" "$(checkbox "$enabled") clone layouts into new workspaces"
  row_label "$APPS_ROW"  "$(checkbox "$apps") reopen the apps each pane was running"
  printf '\r\n'

  if [ -n "$err" ]; then
    printf '  %s%s%s\r\n' "$(printf '\033[31m')" "$err" "$R"
  elif [ "$row" -lt "$CLONE_ROW" ]; then
    # Space only belongs to the row it is standing on, and with two boxes there
    # is no sensible box for it to toggle from the rows above them.
    printf '  %s^ v switch    enter confirm    esc cancel%s\r\n' "$D" "$R"
  else
    printf '  %s^ v switch    space toggle    enter confirm    esc cancel%s\r\n' "$D" "$R"
  fi
}

# ----------------------------------------------------------------------------
# the clone, once an answer is in
# ----------------------------------------------------------------------------
finish() { # [cwd]
  # Confirming is what gets both boxes remembered — written here rather than on
  # the keypress, so an Enter that only produced "no such directory" hasn't
  # quietly decided anything. do_clone reads the apps box back out of the state
  # dir, so it has to be written before the clone starts.
  remember "$CLONE_BOX" 1
  remember "$APPS_BOX" "$apps"
  restore
  printf '\033[H\033[2J\r\n  building layout...\r\n'
  do_clone "$(snapshot)" "$FROM" "$TARGET" "${1:-}"
  printf '%s\n' "$TARGET" >>"$KNOWN_FILE" 2>/dev/null || true
  exit 0
}

# ----------------------------------------------------------------------------
# main loop
# ----------------------------------------------------------------------------
# Assigns by name for the same reason readkey does: `LF=$(ctrl '\n')` would put
# the empty string in LF, and Enter would then be compared against "" and never
# match — the dialog would sit there ignoring the key that confirms it.
ctrl() { # varname escape
  # shellcheck disable=SC2034  # read back by the eval below
  c=$(printf '%bX' "$2")
  eval "$1=\${c%X}"
}
# Octals take printf's %b form, with the leading zero: plain '\177' comes back
# as four literal characters, which would quietly stop Delete from working.
ctrl CR  '\r'
ctrl LF  '\n'
ctrl TAB '\t'
ctrl ESC '\0033'
ctrl BS  '\0010'
ctrl DEL '\0177'
ctrl NAK '\0025'   # ctrl-u
ctrl ETB '\0027'   # ctrl-w
ctrl EOT '\0004'   # ctrl-d

# Test hook: `CLONE_LAYOUT_DIALOG_SOURCE=1 . bin/clone-layout-dialog` loads the
# helpers without taking over the terminal.
if [ "${CLONE_LAYOUT_DIALOG_SOURCE:-}" = "1" ]; then return 0; fi

# Nothing to ask about without a workspace to build and one to copy.
[ -n "$TARGET" ] && [ -n "$FROM" ] || exit 0

trap 'cleanup' EXIT
trap 'cleanup; exit 130' INT TERM HUP

raw_mode
render
empty=0
while :; do
  readkey
  if [ -z "$key" ]; then
    # Nothing to read: normally a stray NUL, but a closed stdin would spin here
    # forever, so give up rather than pin a core.
    empty=$((empty + 1))
    [ "$empty" -lt 100 ] || { log "dialog: stdin closed for $TARGET"; exit 0; }
    continue
  fi
  empty=0
  err=''

  case "$key" in
    "$CR" | "$LF")
      if [ "$enabled" -eq 0 ]; then
        # A deliberate no. Remember both boxes for the next workspace, and record
        # this one as done so simply switching back to it doesn't ask all over
        # again — it is still 1 tab and 1 pane, which is all "fresh" means.
        remember "$CLONE_BOX" 0
        remember "$APPS_BOX" "$apps"
        log "dialog: clone off, leaving $TARGET as it is"
        printf '%s\n' "$TARGET" >>"$KNOWN_FILE" 2>/dev/null || true
        restore
        exit 0
      fi
      # Only the directory row asks for a directory; confirming from row 0 or
      # from the box itself clones as-is.
      if [ "$row" -ne 1 ]; then
        log "dialog: clone $FROM -> $TARGET as-is"
        finish
      fi
      target_dir=$(expand_path "$input")
      if [ -z "$target_dir" ]; then
        err='enter a directory'
      elif [ ! -d "$target_dir" ]; then
        err="no such directory: $(abbrev_path "$target_dir")"
      else
        log "dialog: clone $FROM -> $TARGET in $target_dir"
        finish "$target_dir"
      fi
      ;;
    "$ESC")
      peek_seq
      case "$seq" in
        '[A') [ "$row" -gt 0 ] && row=$((row - 1)) ;;            # up
        '[B') [ "$row" -lt "$LAST_ROW" ] && row=$((row + 1)) ;;   # down
        '')                                  # bare Esc — cancel
          log "dialog: cancelled for $TARGET"
          restore
          exit 0
          ;;
        *) : ;;                              # some other sequence, ignore
      esac
      ;;
    "$EOT")                                  # ctrl-d, same as cancelling
      log "dialog: cancelled for $TARGET"
      restore
      exit 0
      ;;
    "$BS" | "$DEL")
      [ "$row" -eq 1 ] && input=${input%?}
      ;;
    "$NAK")
      [ "$row" -eq 1 ] && input=''
      ;;
    "$ETB")
      if [ "$row" -eq 1 ]; then
        input=${input%"${input##*/}"}        # back to the last /
        input=${input%/}
      fi
      ;;
    ' ')
      # Space ticks the box you are standing on. On the directory row it is an
      # ordinary character instead — directory names do contain spaces. On the
      # top row it does nothing: with two boxes there is no one box for it to
      # mean, and silently appending a space to a path you can't see being
      # edited would be worse than asking you to be on the box you want.
      if [ "$row" -eq 1 ]; then
        input="$input$key"
      elif [ "$row" -eq "$CLONE_ROW" ]; then
        if [ "$enabled" -eq 1 ]; then enabled=0; else enabled=1; fi
      elif [ "$row" -eq "$APPS_ROW" ]; then
        if [ "$apps" -eq 1 ]; then apps=0; else apps=1; fi
      fi
      ;;
    "$TAB")                                  # tab cycles the rows
      row=$(( (row + 1) % (LAST_ROW + 1) ))
      ;;
    *)
      # Printable input goes to the directory, and typing jumps you there so
      # the path is editable without reaching for the arrow keys first.
      case "$key" in
        [[:cntrl:]]) : ;;
        *)
          row=1
          input="$input$key"
          ;;
      esac
      ;;
  esac
  render
done
